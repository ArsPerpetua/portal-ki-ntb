# Dev lokal: backend Express jalan di port terpisah (lihat server/.env.example).
VITE_API_URL=http://localhost:8787/api

# Produksi (Netlify): frontend & Netlify Functions satu domain, jadi relatif saja.
# Set ini di Netlify UI (Site settings -> Environment variables), bukan di file ini.
# VITE_API_URL=/api

# Supabase di arsitektur ini HANYA dipakai sebagai hosting Postgres (lihat server/.env.example
# PG_ADMIN_*/PG_APP_*) — frontend tidak pernah bicara langsung ke Supabase, jadi tidak ada
# VITE_SUPABASE_* di sini. Auth tetap custom JWT lewat API kita sendiri.

# JANGAN MASUKKAN credential berikut pada VITE_ atau client:
# PG_ADMIN_PASSWORD, PG_APP_PASSWORD, JWT_SECRET, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN
