# --- Lokal (Postgres di laptop sendiri) ---
# PG_ADMIN_HOST=localhost
# PG_ADMIN_PORT=5432
# PG_ADMIN_USER=postgres
# PG_ADMIN_PASSWORD=change-me
# PG_ADMIN_DATABASE=portal_ki_ntb
# PG_APP_HOST=localhost
# PG_APP_PORT=5432
# PG_APP_USER=portal_app
# PG_APP_PASSWORD=change-me
# PG_APP_DATABASE=portal_ki_ntb
# PG_SSL=false

# --- Supabase (Project Settings -> Database) ---
# PG_ADMIN_* = Direct connection (port 5432, host db.<ref>.supabase.co, user postgres) —
#   dipakai migrate/seed dan oleh login route (butuh bypass RLS baca password_hash).
# PG_APP_* = Transaction pooler / Supavisor (port 6543, host aws-0-<region>.pooler.supabase.com,
#   user postgres.<ref>) — dipakai di env Netlify, banyak invocation Function paralel.
# Nama database SELALU "postgres" (single-DB-per-project Supabase), BUKAN portal_ki_ntb.
PG_ADMIN_HOST=
PG_ADMIN_PORT=5432
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
PG_ADMIN_DATABASE=postgres

PG_APP_HOST=
PG_APP_PORT=6543
PG_APP_USER=
PG_APP_PASSWORD=
PG_APP_DATABASE=postgres

PG_SSL=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Password default untuk akun seed (dev only)
SEED_SUPERADMIN_PASSWORD="Superadmin#2026"
SEED_STAFF_PASSWORD="Staf#2026"
SEED_PIMPINAN_PASSWORD="Pimpinan#2026"

# Batas ukuran upload dokumen (bytes) — sesuai PRD 10 MiB
MAX_UPLOAD_BYTES=10485760

# Google Drive (arsip dokumen kantor) — lihat PRD §10
# Client ID/Secret dari OAuth Client "Desktop app" di Google Cloud Console (akun arsip khusus kantor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Didapat sekali via script tools/google-drive-auth.ts, lalu tidak berubah sampai dicabut aksesnya
GOOGLE_REFRESH_TOKEN=
# ID folder root Drive tempat semua dokumen kantor disimpan (dibuat otomatis oleh script auth di atas)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
